# Editor defaults for this repository. Line endings are governed by
# .gitattributes; indentation follows the dominant style in each language.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hlsl,hlsli}]
indent_style = space
indent_size = 2

[*.{lua,ps1,psd1,py,cmake}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
